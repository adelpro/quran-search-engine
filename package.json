{
  "name": "quran-search-engine",
  "version": "0.2.0-athar",
  "private": true,
  "description": "A powerful, stateless, and pure TypeScript search engine for the Quran.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/adelpro/quran-search-engine.git"
  },
  "homepage": "https://github.com/adelpro/quran-search-engine",
  "bugs": {
    "url": "https://github.com/adelpro/quran-search-engine/issues"
  },
  "sideEffects": false,
  "workspaces": [
    "examples/*",
    "."
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "docs:start": "cd docs && npx fumapress",
    "format": "prettier --write \"src/**/*.{ts,tsx,json,md}\"",
    "prepare": "husky",
    "prepublishOnly": "yarn build",
    "size-limit": "size-limit",
    "playground:setup": "yarn install && yarn build",
    "playground:react": "yarn workspace react-example dev",
    "playground:vanilla": "yarn workspace vanilla-ts-example dev",
    "playground:angular": "yarn workspace example-angular start",
    "playground:node": "yarn workspace nodejs-example start"
  },
  "keywords": [
    "quran",
    "search",
    "islam",
    "morphology"
  ],
  "author": "Adel Benyahia <contact@adelpro.us.kg>",
  "license": "MIT",
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^19.0.3",
    "@commitlint/config-conventional": "^19.0.3",
    "@size-limit/preset-small-lib": "^12.0.0",
    "@typescript-eslint/eslint-plugin": "^8.56.0",
    "@typescript-eslint/parser": "^8.56.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "husky": "^9.0.11",
    "lint-staged": "^15.2.2",
    "prettier": "^3.2.5",
    "size-limit": "^12.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vitest": "^1.0.0"
  },
  "dependencies": {
    "csv-parse": "^6.1.0",
    "fuse.js": "^7.0.0"
  },
  "size-limit": [
    {
      "path": "dist/index.js",
      "limit": "2 MB"
    },
    {
      "path": "dist/index.mjs",
      "limit": "2 MB"
    }
  ],
  "packageManager": "yarn@4.13.0+sha512.5c20ba010c99815433e5c8453112165e673f1c7948d8d2b267f4b5e52097538658388ebc9f9580656d9b75c5cc996f990f611f99304a2197d4c56d21eea370e7"
}
